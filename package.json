{
  "name": "khata",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "icons": "pwa-assets-generator",
    "test:e2e:live": "BASE_URL=https://khata.omsuhan2004.workers.dev playwright test",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:start": "supabase start -x vector,logflare,edge-runtime,imgproxy,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.4.7",
    "preact": "^11.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "supabase": "^2.122.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
